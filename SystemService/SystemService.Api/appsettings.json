{
  "ConnectionStrings": {},
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Authentication": "Debug",
        "JwtAuthentication": "Debug"
      }
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "SeqUrl": "http://seq.monitoring.svc.cluster.local:5341",
    "OtlpEndpoint": "http://seq.monitoring.svc.cluster.local:5341/ingest/otlp/v1/traces",
    "SeqApiKey": "",
    "OtlpHeaders": ""
  },
  "OpenTelemetry": {
    "ServiceName": "SystemService"
  },
  "Keycloak": {
    "DefaultImportedUserPassword": "Ab@123456"
  },
  "RefreshTokenCleanup": {
    "Enabled": true,
    "IntervalMinutes": 60
  }
}
